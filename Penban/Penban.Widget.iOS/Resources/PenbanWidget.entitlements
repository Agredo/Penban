<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The widget reads the snapshot and the previews the app writes into the shared container.
	     Identifier mirrors WidgetSharedStorage.GroupId in the app; the container is only handed out
	     when both targets claim the same group. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.agredoapplication.panban</string>
	</array>
</dict>
</plist>
