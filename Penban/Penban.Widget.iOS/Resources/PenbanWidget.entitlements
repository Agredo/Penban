<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xcode merges these with what the provisioning profile grants, so naming the App Group is
	     enough here. The MAUI build signs the embedded copy again and only reads a file, which is
	     why it uses build/PenbanWidget.entitlements - written by scripts/ios-widget.sh from the
	     finished extension. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.agredoapplication.penban</string>
	</array>
</dict>
</plist>
