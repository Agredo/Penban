<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:styles="clr-namespace:Penban.Maui.Views.Resources.Styles;assembly=Penban.Maui.Views"
             x:Class="Penban.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <!-- Design tokens from Penban.Maui.Views must merge before the template
                     Styles.xaml, which references them (Shell colors). -->
                <styles:Colors />
                <styles:ColorsDark />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <!-- Shared component styles built on the tokens. -->
                <styles:Theme />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
