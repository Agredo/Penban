<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- The bundled faces, declared so CoreText knows them from launch. MAUI registers the fonts
	     it is asked for by name, but the widget previews are drawn through SkiaSharp, which resolves
	     a family against the fonts the system already knows - without this list "Open Sans" falls
	     back to the system face and the previews no longer match the app. -->
	<key>UIAppFonts</key>
	<array>
		<string>OpenSans-Regular.ttf</string>
		<string>OpenSans-Semibold.ttf</string>
		<string>FluentSystemIcons-Regular.ttf</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
	<!-- Adopts the scene lifecycle, which iOS 27 refuses to start the app without: an app whose
	     plist has no scene manifest is aborted in UIApplicationMain with "No scene lifecycle
	     adoption" (EXC_BREAKPOINT). The configuration name is not free to choose - MAUI only builds
	     its window for the session whose configuration is called
	     __MAUI_DEFAULT_SCENE_CONFIGURATION__ (MauiUIApplicationDelegate.MauiSceneConfigurationKey),
	     and that session's delegate has to be the class named here. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>__MAUI_DEFAULT_SCENE_CONFIGURATION__</string>
					<key>UISceneDelegateClassName</key>
					<string>SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- The board a tapped home screen widget stands for arrives as penban://board/<id>. The scheme
	     has to be declared here for iOS to hand the URL to the app at all; the widget builds that
	     address in PenbanWidget.swift and Platforms/iOS/SceneDelegate.cs reads it. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.agredoapplication.penban.board</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>penban</string>
			</array>
		</dict>
	</array>
	<!-- TestFlight/App Store: the app uses no non-exempt encryption (only standard
	     HTTPS/TLS), so this skips the export-compliance question on every upload.
	     Switch to <true/> if non-exempt cryptography is ever added. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
