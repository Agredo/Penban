<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(PenbanNetVersion)-windows10.0.19041.0;$(PenbanNetVersion)-ios;$(PenbanNetVersion)-maccatalyst;$(PenbanNetVersion)-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <!-- Windows needs WinExe, otherwise the app host is built with the console subsystem and Windows
         opens a console window on launch. The MAUI SDK does this rewrite itself in
         Microsoft.Maui.Sdk.Before.targets, but that import is skipped when the build runs with
         MSBuildEnableWorkloadResolver=false (needed on this machine). -->
    <OutputType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">WinExe</OutputType>
    <RootNamespace>Penban.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <!-- iOS has no CoreCLR runtime pack (only Mono or NativeAOT), so keep Mono there. -->
    <UseMonoRuntime Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'">false</UseMonoRuntime>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>

    <ApplicationTitle>Penban</ApplicationTitle>
    <ApplicationId>com.agredoapplication.panban</ApplicationId>
    <ApplicationDisplayVersion>0.4.3</ApplicationDisplayVersion>
    <ApplicationVersion>11</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <!-- Disable the WindowsAppSDK Foundation module-init deployment check: on this dev machine it
         fails with REGDB_E_CLASSNOTREG (DeploymentInitializeOptions WinRT activation) even though
         the runtime is installed. The app doesn't rely on runtime self-repair, so skip it. -->
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>

    <!-- Unpackaged (non-MSIX) launch on this machine can't resolve WinUI's WinRT classes via the
         registry (REGDB_E_CLASSNOTREG for Microsoft.UI.Xaml.Application). Self-contained deployment
         enables "Undocked RegFree WinRT", which activates WinUI types via an app-local manifest
         instead of registry lookups. -->
    <WindowsAppSDKSelfContained Condition="$(TargetFramework.Contains('-windows'))">true</WindowsAppSDKSelfContained>

    <!-- Force unpackaged (non-MSIX) Windows launch/build so Visual Studio never requires an
         'MsixPackage' launch profile. -->
    <WindowsPackageType Condition="$(TargetFramework.Contains('-windows'))">None</WindowsPackageType>
  </PropertyGroup>

  <!-- Opt-in MSIX packaging, off by default so the ordinary build stays unpackaged:
         dotnet build Penban.Maui.csproj -f net10.0-windows10.0.19041.0 -c Release -p:PenbanMsix=true
       The single-project MSIX tooling is opt-in through EnableMsixTooling; GenerateAppxPackageOnBuild
       makes the build itself write the package instead of only Visual Studio's Package and Publish.
       All of this has to stand in the project file, not in a Directory.Build.targets: the MSIX targets
       read these properties while they are evaluated, and those targets are imported before
       Directory.Build.targets. The result lands in AppxPackageDir, which defaults to AppPackages\ next
       to the project - pass -p:AppxPackageDir=<path> to put it somewhere else.

       A bundle covering both architectures needs one build per architecture and then a bundle pass,
       because AppxBundlePlatforms may only name packages that already exist on disk:
         -p:RuntimeIdentifier=win-x64   -p:PlatformTarget=x64   -p:Platform=x64
         -p:RuntimeIdentifier=win-arm64 -p:PlatformTarget=arm64 -p:Platform=arm64
         -p:AppxBundlePlatforms=x64|arm64
       Each per-architecture pass records its package in BundleArtifacts\<arch>.txt, and the bundle
       pass consumes those lists.

       Sideload builds are signed with the local "Penban Local" certificate, whose public half ships
       as Penban\dist\penban-local.cer and which must also sit in the trusted root store. The
       thumbprint is machine specific - a build on a machine without that certificate has to pass
       -p:AppxPackageSigningEnabled=false. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-windows')) And '$(PenbanMsix)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxBundle>Always</AppxBundle>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <PackageCertificateThumbprint>8640103D683CB1AE63A24C9DE5C4587BB349AAEA</PackageCertificateThumbprint>
  </PropertyGroup>

  <!-- The home screen widget: the app and the extension share the App Group container declared
       here, so both sides have to claim it. Without the file the container is never handed out and
       the widget stays empty. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <CodesignEntitlements>Platforms\iOS\Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>

  <!-- iOS Release builds crash on launch (fatal allocation failure in the native UIKit/Observation
       startup path) when Mono AOT-compiled code is used. Running the assemblies with the Mono
       interpreter instead of AOT avoids it. `RunAOTCompilation=false` alone has no effect - only
       `UseInterpreter` actually skips AOT. Costs some startup performance but is stable. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-ios')) And '$(Configuration)' == 'Release'">
    <UseInterpreter>true</UseInterpreter>
  </PropertyGroup>

  <!-- Compiles Platforms/iOS/PenbanWidgetReloader.swift into the app executable.
       WidgetKit is a Swift-only framework, so "draw the widget again" - the call that makes a change
       show up on the home screen without waiting for the widget's own next refresh - cannot be made
       from managed code at all, and the iOS SDK's build cannot compile Swift. This target runs the
       toolchain's compiler for the object and links it by hand.

       The object cannot travel as a NativeReference: the SDK expands those before it compiles
       anything, and it does not expand them on the way to the link at all. And the link flags cannot
       sit in an ItemGroup above either - only @(LinkerArgument) is read after the SDK has collected
       its own flags, while @(ExtraLinkerArg) and friends are folded in earlier than this target runs.
       Linchpin: Penban.Maui.Views/Widget/IosWidgetRefresh.cs, the caller. -->
  <Target Name="LinkWidgetReloader"
          BeforeTargets="_ComputeLinkNativeExecutableInputs"
          DependsOnTargets="_DetectSdkLocations"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <PropertyGroup>
      <WidgetReloaderSource>$(MSBuildProjectDirectory)/Platforms/iOS/PenbanWidgetReloader.swift</WidgetReloaderSource>
      <WidgetReloaderObject>$(IntermediateOutputPath)PenbanWidgetReloader.o</WidgetReloaderObject>

      <!-- The object ends up inside the app, so it has to be built for the same platform and
           architecture: the device, or the simulator on a Mac. The deployment target is the app's own
           floor - a higher one would let the compiler leave the call out on older iOS. -->
      <WidgetReloaderSdk>iphoneos</WidgetReloaderSdk>
      <WidgetReloaderSdk Condition="$(RuntimeIdentifier.Contains('simulator'))">iphonesimulator</WidgetReloaderSdk>
      <WidgetReloaderArchitecture>arm64</WidgetReloaderArchitecture>
      <WidgetReloaderArchitecture Condition="$(RuntimeIdentifier.EndsWith('x64'))">x86_64</WidgetReloaderArchitecture>
      <WidgetReloaderTarget>$(WidgetReloaderArchitecture)-apple-ios$(SupportedOSPlatformVersion)</WidgetReloaderTarget>
      <WidgetReloaderTarget Condition="'$(WidgetReloaderSdk)' == 'iphonesimulator'">$(WidgetReloaderTarget)-simulator</WidgetReloaderTarget>
    </PropertyGroup>

    <ItemGroup>
      <!-- force_load rather than a plain object file: nothing in the app references the class by
           symbol, it is looked up by name at runtime, and this keeps every member of the object. -->
      <LinkerArgument Include="-Wl,-force_load,$(WidgetReloaderObject)" />
      <!-- The object autolinks WidgetKit itself; naming the framework keeps the link independent of
           that. -->
      <LinkerArgument Include="-Wl,-framework,WidgetKit" />

      <!-- So that a clean build really starts over. -->
      <FileWrites Include="$(WidgetReloaderObject)" />
    </ItemGroup>

    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(WidgetReloaderObject)'))" />
    <!-- The freshness test lives in the shell, not in the Condition: MSBuild does not offer a property
         function that compares two timestamps, and a missing object file makes the source the newer one. -->
    <Exec Command="if [ ! -f &quot;$(WidgetReloaderObject)&quot; ] || [ &quot;$(WidgetReloaderSource)&quot; -nt &quot;$(WidgetReloaderObject)&quot; ]; then xcrun --sdk $(WidgetReloaderSdk) swiftc -target $(WidgetReloaderTarget) -sdk &quot;$(_SdkRoot)&quot; -parse-as-library -O -c &quot;$(WidgetReloaderSource)&quot; -o &quot;$(WidgetReloaderObject)&quot;; fi" />
  </Target>

  <!-- The ONNX Runtime ships its managed assembly with a DllImport for the custom-op entry point of
       onnxruntime-extensions, which on iOS resolves to "__Internal" and so becomes a hard
       requirement of the link - see the source file for why, and why Penban answers it with a stub.
       Same shape as LinkWidgetReloader: the iOS SDK compiles no C source of its own accord, so this
       target compiles the object and hands it to the link. -->
  <Target Name="LinkOnnxRuntimeExtensionsStub"
          BeforeTargets="_ComputeLinkNativeExecutableInputs"
          DependsOnTargets="_DetectSdkLocations"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <PropertyGroup>
      <OnnxRuntimeStubSource>$(MSBuildProjectDirectory)/Platforms/iOS/OnnxRuntimeExtensionsStub.c</OnnxRuntimeStubSource>
      <OnnxRuntimeStubObject>$(IntermediateOutputPath)OnnxRuntimeExtensionsStub.o</OnnxRuntimeStubObject>

      <OnnxRuntimeStubSdk>iphoneos</OnnxRuntimeStubSdk>
      <OnnxRuntimeStubSdk Condition="$(RuntimeIdentifier.Contains('simulator'))">iphonesimulator</OnnxRuntimeStubSdk>
      <OnnxRuntimeStubArchitecture>arm64</OnnxRuntimeStubArchitecture>
      <OnnxRuntimeStubArchitecture Condition="$(RuntimeIdentifier.EndsWith('x64'))">x86_64</OnnxRuntimeStubArchitecture>
      <OnnxRuntimeStubTarget>$(OnnxRuntimeStubArchitecture)-apple-ios$(SupportedOSPlatformVersion)</OnnxRuntimeStubTarget>
      <OnnxRuntimeStubTarget Condition="'$(OnnxRuntimeStubSdk)' == 'iphonesimulator'">$(OnnxRuntimeStubTarget)-simulator</OnnxRuntimeStubTarget>
    </PropertyGroup>

    <ItemGroup>
      <!-- A plain object file suffices here, unlike for the widget reloader: the linker asks for the
           symbol itself. -->
      <LinkerArgument Include="$(OnnxRuntimeStubObject)" />

      <!-- So that a clean build really starts over. -->
      <FileWrites Include="$(OnnxRuntimeStubObject)" />
    </ItemGroup>

    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(OnnxRuntimeStubObject)'))" />
    <!-- The freshness test lives in the shell for the same reason as above: MSBuild has no property
         function that compares two timestamps. -->
    <Exec Command="if [ ! -f &quot;$(OnnxRuntimeStubObject)&quot; ] || [ &quot;$(OnnxRuntimeStubSource)&quot; -nt &quot;$(OnnxRuntimeStubObject)&quot; ]; then xcrun --sdk $(OnnxRuntimeStubSdk) clang -target $(OnnxRuntimeStubTarget) -isysroot &quot;$(_SdkRoot)&quot; -O2 -c &quot;$(OnnxRuntimeStubSource)&quot; -o &quot;$(OnnxRuntimeStubObject)&quot;; fi" />
  </Target>

  <ItemGroup>
    <!-- App Icon: the Penban logo tile carries the brand on every platform. Apple icons must not
         contain transparency (App Store rule), so iOS and Mac Catalyst get the variant with the
         dark background; Windows and Android show the same logo without any background.
         Both variants must be called appicon.svg: the Apple icon set is named after the file and
         Platforms/iOS/Info.plist points XSAppIconAssets at Assets.xcassets/appicon.appiconset. -->
    <MauiIcon Include="Resources\AppIcon\iOS\appicon.svg"
              Condition="$(TargetFramework.Contains('-ios')) Or $(TargetFramework.Contains('-maccatalyst'))" />
    <MauiIcon Include="Resources\AppIcon\appicon.svg"
              Condition="!$(TargetFramework.Contains('-ios')) And !$(TargetFramework.Contains('-maccatalyst'))" />

    <!-- Splash Screen: dark, so the indigo logo tile stays visible on it. -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F1115" BaseSize="128,128" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\penban_logo.svg" BaseSize="128,128" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- On Windows, WindowsAppSDK.WinUI globs **/*.xaml as Page items (compiled by the WinUI/UWP
       markup compiler) in addition to MAUI's own MauiXaml classification, which fails because the
       WinUI compiler doesn't understand MAUI's XAML dialect. Remove the duplicate classification. -->
  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <Page Remove="**\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="CommunityToolkit.Maui" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Penban.Maui.Views\Penban.Maui.Views.csproj" />
    <ProjectReference Include="..\Penban.Maui.Services\Penban.Maui.Services.csproj" />
    <ProjectReference Include="..\Penban.Services\Penban.Services.csproj" />
    <ProjectReference Include="..\Penban.Data\Penban.Data.csproj" />
    <!-- The ONNX recogniser, so its model and its native runtime travel with the app. -->
    <ProjectReference Include="..\Penban.Recognition.Onnx\Penban.Recognition.Onnx.csproj" />
  </ItemGroup>

  <!-- Where the Xcode project leaves the built extension: scripts/ios-widget.sh writes the .appex
       into build/<Configuration>-iphoneos, one folder per configuration the way Xcode does it. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <WidgetExtensionDir>$(MSBuildProjectDirectory)/../Penban.Widget.iOS/build</WidgetExtensionDir>
    <WidgetExtensionOutput>$(Configuration)-iphoneos</WidgetExtensionOutput>
    <WidgetExtensionPath>$(WidgetExtensionDir)/$(WidgetExtensionOutput)/PenbanWidget.appex</WidgetExtensionPath>
  </PropertyGroup>

  <!-- The built widget extension is embedded into the app bundle from here. It is a separate Xcode
       project (Penban/Penban.Widget.iOS) because only Xcode can build one, so the app build only
       picks up the .appex that project leaves behind - which is why this is guarded by Exists: on a
       machine without Xcode (this one) the app still builds, just without a widget.

       AdditionalAppExtensions takes the extension's folder and appends BuildOutput to find the
       .appex, so the two together have to name the folder the bundle sits in.

       The entitlements have to be named as well, and they are the ones Xcode produced, not the file
       in Penban.Widget.iOS/Resources: embedding copies the .appex into the app bundle, deletes the
       signature Xcode put on it and signs it again here. Signing only reads what stands in the file
       handed to it, so the keys Xcode takes from the provisioning profile (application-identifier,
       team identifier, beta-reports-active) would be missing - App Store Connect rejects such an
       upload (90075). scripts/ios-widget.sh therefore writes the entitlements of the finished
       .appex next to it and this path points at that copy. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And Exists('$(WidgetExtensionPath)')">
    <AdditionalAppExtensions Include="$(WidgetExtensionDir)">
      <Name>PenbanWidget</Name>
      <BuildOutput>$(WidgetExtensionOutput)</BuildOutput>
      <CodesignEntitlements>$(WidgetExtensionDir)/PenbanWidget.entitlements</CodesignEntitlements>
    </AdditionalAppExtensions>
  </ItemGroup>

  <!-- Skipping the extension above is silent, and an app that ships without its widget is only
       noticed on the home screen - so the omission is named. A warning, not an error: without Xcode
       the app still builds, it just has no widget. -->
  <Target Name="WarnMissingWidgetExtension"
          BeforeTargets="Build"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And !Exists('$(WidgetExtensionPath)')">
    <Warning Text="No widget extension at Penban.Widget.iOS/build/$(WidgetExtensionOutput)/PenbanWidget.appex - this build has no home screen widget. Build the extension with scripts/ios-widget.sh build." />
  </Target>

</Project>
