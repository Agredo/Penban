<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(PenbanNetVersion)-windows10.0.19041.0;$(PenbanNetVersion)-ios;$(PenbanNetVersion)-maccatalyst;$(PenbanNetVersion)-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <!-- Windows needs WinExe, otherwise the app host is built with the console subsystem and Windows
         opens a console window on launch. The MAUI SDK does this rewrite itself in
         Microsoft.Maui.Sdk.Before.targets, but that import is skipped when the build runs with
         MSBuildEnableWorkloadResolver=false (needed on this machine). -->
    <OutputType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">WinExe</OutputType>
    <RootNamespace>Penban.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <!-- iOS has no CoreCLR runtime pack (only Mono or NativeAOT), so keep Mono there. -->
    <UseMonoRuntime Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'">false</UseMonoRuntime>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>

    <ApplicationTitle>Penban</ApplicationTitle>
    <ApplicationId>com.agredoapplication.panban</ApplicationId>
    <ApplicationDisplayVersion>0.3.1</ApplicationDisplayVersion>
    <ApplicationVersion>7</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <!-- Disable the WindowsAppSDK Foundation module-init deployment check: on this dev machine it
         fails with REGDB_E_CLASSNOTREG (DeploymentInitializeOptions WinRT activation) even though
         the runtime is installed. The app doesn't rely on runtime self-repair, so skip it. -->
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>

    <!-- Unpackaged (non-MSIX) launch on this machine can't resolve WinUI's WinRT classes via the
         registry (REGDB_E_CLASSNOTREG for Microsoft.UI.Xaml.Application). Self-contained deployment
         enables "Undocked RegFree WinRT", which activates WinUI types via an app-local manifest
         instead of registry lookups. -->
    <WindowsAppSDKSelfContained Condition="$(TargetFramework.Contains('-windows'))">true</WindowsAppSDKSelfContained>

    <!-- Force unpackaged (non-MSIX) Windows launch/build so Visual Studio never requires an
         'MsixPackage' launch profile. -->
    <WindowsPackageType Condition="$(TargetFramework.Contains('-windows'))">None</WindowsPackageType>
  </PropertyGroup>

  <!-- The home screen widget: the app and the extension share the App Group container declared
       here, so both sides have to claim it. Without the file the container is never handed out and
       the widget stays empty. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <CodesignEntitlements>Platforms\iOS\Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>

  <!-- iOS Release builds crash on launch (fatal allocation failure in the native UIKit/Observation
       startup path) when Mono AOT-compiled code is used. Running the assemblies with the Mono
       interpreter instead of AOT avoids it. `RunAOTCompilation=false` alone has no effect - only
       `UseInterpreter` actually skips AOT. Costs some startup performance but is stable. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-ios')) And '$(Configuration)' == 'Release'">
    <UseInterpreter>true</UseInterpreter>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon: the Penban logo tile carries the brand on every platform. Apple icons must not
         contain transparency (App Store rule), so iOS and Mac Catalyst get the variant with the
         dark background; Windows and Android show the same logo without any background.
         Both variants must be called appicon.svg: the Apple icon set is named after the file and
         Platforms/iOS/Info.plist points XSAppIconAssets at Assets.xcassets/appicon.appiconset. -->
    <MauiIcon Include="Resources\AppIcon\iOS\appicon.svg"
              Condition="$(TargetFramework.Contains('-ios')) Or $(TargetFramework.Contains('-maccatalyst'))" />
    <MauiIcon Include="Resources\AppIcon\appicon.svg"
              Condition="!$(TargetFramework.Contains('-ios')) And !$(TargetFramework.Contains('-maccatalyst'))" />

    <!-- Splash Screen: dark, so the indigo logo tile stays visible on it. -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F1115" BaseSize="128,128" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\penban_logo.svg" BaseSize="128,128" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- On Windows, WindowsAppSDK.WinUI globs **/*.xaml as Page items (compiled by the WinUI/UWP
       markup compiler) in addition to MAUI's own MauiXaml classification, which fails because the
       WinUI compiler doesn't understand MAUI's XAML dialect. Remove the duplicate classification. -->
  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <Page Remove="**\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="CommunityToolkit.Maui" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Penban.Maui.Views\Penban.Maui.Views.csproj" />
    <ProjectReference Include="..\Penban.Maui.Services\Penban.Maui.Services.csproj" />
    <ProjectReference Include="..\Penban.Services\Penban.Services.csproj" />
    <ProjectReference Include="..\Penban.Data\Penban.Data.csproj" />
  </ItemGroup>

  <!-- Where the Xcode project leaves the built extension: scripts/ios-widget.sh writes the .appex
       into build/<Configuration>-iphoneos, one folder per configuration the way Xcode does it. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <WidgetExtensionDir>$(MSBuildProjectDirectory)/../Penban.Widget.iOS/build</WidgetExtensionDir>
    <WidgetExtensionOutput>$(Configuration)-iphoneos</WidgetExtensionOutput>
    <WidgetExtensionPath>$(WidgetExtensionDir)/$(WidgetExtensionOutput)/PenbanWidget.appex</WidgetExtensionPath>
  </PropertyGroup>

  <!-- The built widget extension is embedded into the app bundle from here. It is a separate Xcode
       project (Penban/Penban.Widget.iOS) because only Xcode can build one, so the app build only
       picks up the .appex that project leaves behind - which is why this is guarded by Exists: on a
       machine without Xcode (this one) the app still builds, just without a widget.

       AdditionalAppExtensions takes the extension's folder and appends BuildOutput to find the
       .appex, so the two together have to name the folder the bundle sits in.

       The entitlements have to be named as well: embedding copies the .appex into the app bundle and
       deletes the signature Xcode put on it, so the appex is signed again here - without the App
       Group it would be signed without access to the folder the app writes the snapshot to, and the
       widget would stay empty however often the app refreshes it. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And Exists('$(WidgetExtensionPath)')">
    <AdditionalAppExtensions Include="$(WidgetExtensionDir)">
      <Name>PenbanWidget</Name>
      <BuildOutput>$(WidgetExtensionOutput)</BuildOutput>
      <CodesignEntitlements>$(MSBuildProjectDirectory)/../Penban.Widget.iOS/Resources/PenbanWidget.entitlements</CodesignEntitlements>
    </AdditionalAppExtensions>
  </ItemGroup>

  <!-- Skipping the extension above is silent, and an app that ships without its widget is only
       noticed on the home screen - so the omission is named. A warning, not an error: without Xcode
       the app still builds, it just has no widget. -->
  <Target Name="WarnMissingWidgetExtension"
          BeforeTargets="Build"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And !Exists('$(WidgetExtensionPath)')">
    <Warning Text="No widget extension at Penban.Widget.iOS/build/$(WidgetExtensionOutput)/PenbanWidget.appex - this build has no home screen widget. Build the extension with scripts/ios-widget.sh build." />
  </Target>

</Project>
