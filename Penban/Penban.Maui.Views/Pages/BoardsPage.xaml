<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:markup="clr-namespace:Penban.Maui.Views.Markup"
             xmlns:controls="clr-namespace:Penban.Maui.Views.Controls"
             x:Class="Penban.Maui.Views.Pages.BoardsPage"
             x:Name="ThisPage"
             Title="{markup:Translate BoardsTitle}"
             Shell.NavBarIsVisible="False"
             Style="{StaticResource AppPage}">
    <ContentPage.Resources>
        <!-- Two layouts for a board card: side by side where there is room, stacked on a narrow screen.
             The page picks one by its width; a card cannot rearrange itself, because changing the layout
             of a live grid in a list takes WinUI down. What a board card looks like is written once, in
             Controls/BoardCard, so it is the same card on every page that lists boards. -->
        <DataTemplate x:Key="WideBoardCard">
            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,6">
                <Border.GestureRecognizers>
                    <!-- Tap opens the board, a drag carries it to another place in the list: the two do
                         not get in each other's way, because a drag only starts once the card is moved.
                         What is picked up is remembered in the code-behind - the drop only names the
                         row it lands on. -->
                    <TapGestureRecognizer Tapped="OnBoardTapped" />
                    <DragGestureRecognizer CanDrag="True"
                                           DragStarting="OnBoardDragStarting"
                                           DropCompleted="OnBoardDropCompleted" />
                    <DropGestureRecognizer AllowDrop="True" Drop="OnBoardDrop" />
                </Border.GestureRecognizers>

                <controls:BoardCard Narrow="False"
                                    ShareCommand="{Binding Source={x:Reference ThisPage}, Path=BoardActions.ShareCommand}"
                                    EditCommand="{Binding Source={x:Reference ThisPage}, Path=BoardActions.EditCommand}"
                                    DeleteCommand="{Binding Source={x:Reference ThisPage}, Path=BoardActions.DeleteCommand}" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="NarrowBoardCard">
            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,6">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBoardTapped" />
                    <DragGestureRecognizer CanDrag="True"
                                           DragStarting="OnBoardDragStarting"
                                           DropCompleted="OnBoardDropCompleted" />
                    <DropGestureRecognizer AllowDrop="True" Drop="OnBoardDrop" />
                </Border.GestureRecognizers>

                <controls:BoardCard Narrow="True"
                                    ShareCommand="{Binding Source={x:Reference ThisPage}, Path=BoardActions.ShareCommand}"
                                    EditCommand="{Binding Source={x:Reference ThisPage}, Path=BoardActions.EditCommand}"
                                    DeleteCommand="{Binding Source={x:Reference ThisPage}, Path=BoardActions.DeleteCommand}" />
            </Border>
        </DataTemplate>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,*" Padding="20,12" RowSpacing="16">

        <!-- Header: menu + page title + search + settings + whole-database transfer. The mark that
             used to lead it is in the head of the menu now, which is where the menu button leads. The
             primary add action is not one of them: it floats over the list in the bottom right corner,
             where a thumb reaches it without crossing the page and where it takes no share of the bar
             from the title. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
            <Button Grid.Column="0"
                    Text="&#xf561;"
                    Style="{StaticResource GhostIconButton}"
                    Clicked="OnMenuClicked"
                    SemanticProperties.Description="{markup:Translate Menu}"
                    VerticalOptions="Center" />
            <Label Grid.Column="1"
                   Text="{markup:Translate BoardsTitle}"
                   Style="{StaticResource LargeTitleLabel}"
                   VerticalOptions="Center" />
            <Button Grid.Column="2"
                    Text="&#xf690;"
                    Style="{StaticResource GhostIconButton}"
                    Clicked="OnSearchClicked"
                    SemanticProperties.Description="{markup:Translate SearchTitle}"
                    VerticalOptions="Center" />
            <Button Grid.Column="3"
                    Text="&#xf588;"
                    Style="{StaticResource GhostIconButton}"
                    Clicked="OnSettingsClicked"
                    SemanticProperties.Description="{markup:Translate Settings}"
                    VerticalOptions="Center" />
            <Button Grid.Column="4"
                    Text="&#xe467;"
                    Style="{StaticResource GhostIconButton}"
                    Clicked="OnTransferClicked"
                    SemanticProperties.Description="{markup:Translate TransferTitle}"
                    VerticalOptions="Center" />
        </Grid>

        <!-- Empty state (nothing there and nothing on its way, see BoardsViewModel) -->
        <VerticalStackLayout Grid.Row="1"
                             Spacing="14"
                             VerticalOptions="Center"
                             IsVisible="{Binding ShowEmptyState}">
            <Label Text="&#xf1e3;"
                   Style="{StaticResource IconLabel}"
                   FontSize="56"
                   TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                   HorizontalTextAlignment="Center" />
            <Label Text="{markup:Translate NoBoardsYet}"
                   Style="{StaticResource CaptionLabel}"
                   FontSize="{StaticResource FontSizeBody}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Board cards -->
        <CollectionView x:Name="BoardsList" Grid.Row="1" ItemsSource="{Binding Boards}" />

        <!-- Over the list: what says that the overview is still reading. Every row is read with its
             summary and a fan of its notes, which is the wait a visit to the overview begins with -
             the empty state above is held back for as long as it lasts, so a list that is still
             filling cannot claim there is nothing there. -->
        <ActivityIndicator Grid.Row="1"
                           IsVisible="{Binding IsLoading}"
                           IsRunning="{Binding IsLoading}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!-- The add action, floating over the list in the bottom right corner. Last in the grid, so it
             lies over the cards rather than under them. Plus = U+F10A. It opens the details page
             rather than asking for a name on the spot, so that the extended mode is a fold of the
             same page instead of a second way in. -->
        <Button Grid.Row="1"
                Text="&#xf10a;"
                Style="{StaticResource FabButton}"
                Clicked="OnAddBoardClicked"
                SemanticProperties.Description="{markup:Translate AddBoard}"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,4,4" />
    </Grid>
</ContentPage>
