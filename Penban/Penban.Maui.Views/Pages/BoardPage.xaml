<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:markup="clr-namespace:Penban.Maui.Views.Markup"
             xmlns:controls="clr-namespace:Penban.Maui.Views.Controls"
             xmlns:kanban="clr-namespace:Syncfusion.Maui.Kanban;assembly=Syncfusion.Maui.Kanban"
             x:Class="Penban.Maui.Views.Pages.BoardPage"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             Style="{StaticResource AppPage}">
    <Grid RowDefinitions="Auto,*" Padding="12" RowSpacing="12">

        <!-- Own header instead of the Shell nav bar: the Windows Shell nav bar renders no back
             button, so the app draws its own and every platform gets the same way back.
             Adding a column belongs here rather than under the board: it acts on the board, not on
             a single column, and it keeps the whole height of the board free for the notes.
             The note button sits beside it for the same reason: the note belongs to the board, not
             to a column, and it is what the board shows on the overview and on the home screen.
             The settings button is the same one as on the overview: the drawing settings are tried
             out on a note, so they have to be reachable without leaving the board. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
            <Button Grid.Column="0"
                    Text="&#xf15c;"
                    Style="{StaticResource GhostIconButton}"
                    Clicked="OnBackClicked"
                    SemanticProperties.Description="{markup:Translate BoardsTitle}" />
            <Label Grid.Column="1"
                   Text="{Binding Title}"
                   Style="{StaticResource TitleLabel}"
                   LineBreakMode="TailTruncation"
                   VerticalOptions="Center" />
            <!-- Filter = U+F407, Search = U+F690. Pressing one slides its controls in to the left of
                 the button, inside this row, so the board below keeps its place; the title gives up
                 the room. The button is accent while it is narrowing the board down. -->
            <ScrollView x:Name="FilterTagScroll"
                        Grid.Column="2"
                        IsVisible="False"
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        MaximumWidthRequest="320"
                        VerticalOptions="Center">
                <HorizontalStackLayout x:Name="FilterTagRow" Spacing="4" />
            </ScrollView>
            <Button x:Name="FilterButton"
                    Grid.Column="3"
                    Text="&#xf407;"
                    Style="{StaticResource GhostIconButton}"
                    Clicked="OnFilterClicked"
                    SemanticProperties.Description="Filter" />
            <Border x:Name="SearchEntryHost"
                    Grid.Column="4"
                    IsVisible="False"
                    Padding="10,0"
                    WidthRequest="200"
                    VerticalOptions="Center"
                    Style="{StaticResource InputSurface}">
                <Entry x:Name="FilterEntry"
                       Placeholder="{markup:Translate SearchPlaceholder}"
                       TextChanged="OnFilterTextChanged" />
            </Border>
            <Button x:Name="SearchButton"
                    Grid.Column="5"
                    Text="&#xf690;"
                    Style="{StaticResource GhostIconButton}"
                    Clicked="OnSearchClicked"
                    SemanticProperties.Description="{markup:Translate SearchTitle}" />
            <Button Grid.Column="6"
                    Text="&#xf6b0;"
                    Style="{StaticResource GhostIconButton}"
                    Clicked="OnShareClicked"
                    SemanticProperties.Description="{markup:Translate ShareBoard}" />
            <!-- Note = U+F56C. Accent while the board carries a note, so the header says at a glance
                 whether there is one without the button having to be pressed. -->
            <Button x:Name="BoardNoteButton"
                    Grid.Column="7"
                    Text="&#xf56c;"
                    Style="{StaticResource GhostIconButton}"
                    Clicked="OnBoardNoteClicked"
                    SemanticProperties.Description="{markup:Translate BoardNote}" />
            <Button Grid.Column="8"
                    Text="&#xf588;"
                    Style="{StaticResource GhostIconButton}"
                    Clicked="OnSettingsClicked"
                    SemanticProperties.Description="{markup:Translate Settings}" />
            <Button Grid.Column="9"
                    Text="&#xf2fd;"
                    Style="{StaticResource AccentIconButton}"
                    Command="{Binding AddColumnCommand}"
                    SemanticProperties.Description="{markup:Translate AddColumn}" />
        </Grid>
        <!-- ColumnWidth is only the starting value: BoardPage recomputes it on resize so the
             columns fill the window, never dropping below the 180 that keeps a note writable.
             It also sets MinimumColumnWidth and MaximumColumnWidth, without which the control
             cuts every column down to its own default maximum of 450 - and the notes, sized for
             the width that was asked for, would be cut off at the side of the column.
             The notes themselves are as wide as their column. -->
        <kanban:SfKanban x:Name="BoardKanban"
                         Grid.Row="1"
                         AutoGenerateColumns="False"
                         ColumnMappingPath="Category"
                         ColumnWidth="180"
                         BackgroundColor="Transparent">
            <!-- No SfKanban.HeaderStyle here: KanbanHeaderStyle is internal in
                 Syncfusion.Maui.Kanban 34.x and crashes the XAML parser at runtime. -->
            <kanban:SfKanban.HeaderTemplate>
                <DataTemplate>
                    <Grid Padding="14,10,10,10"
                          Background="{AppThemeBinding Light={StaticResource SurfaceSecondaryLight}, Dark={StaticResource SurfaceSecondaryDark}}"
                          ColumnDefinitions="*,Auto,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRenameColumnTapped" />
                            </HorizontalStackLayout.GestureRecognizers>
                            <Label Style="{StaticResource SubtitleLabel}"
                                   Text="{Binding Title}"
                                   VerticalOptions="Center" />
                            <Border Padding="8,1"
                                    Background="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                    StrokeShape="RoundRectangle 9"
                                    VerticalOptions="Center">
                                <Label FontSize="12"
                                       Style="{StaticResource CaptionLabel}"
                                       Text="{Binding ItemsCount}" />
                            </Border>
                        </HorizontalStackLayout>
                        <Button Grid.Column="1"
                                Clicked="OnDeleteColumnClicked"
                                SemanticProperties.Description="Spalte löschen"
                                Style="{StaticResource DangerGhostIconButton}"
                                Text="&#xf36a;"
                                VerticalOptions="Center" />
                        <Button Grid.Column="2"
                                Clicked="OnAddCardClicked"
                                SemanticProperties.Description="Karte hinzufügen"
                                Style="{StaticResource AccentIconButton}"
                                Text="&#xf10a;"
                                VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </kanban:SfKanban.HeaderTemplate>
            <kanban:SfKanban.CardTemplate>
                <DataTemplate>
                    <!-- The card is the note: no frame of its own, so the column reads as a stack
                         of stuck-on notes rather than as a list of rows.
                         The transparent cell is deliberately larger than the note: the note is
                         rotated by up to ~2.8 degrees and casts a 6pt shadow, so its bounding box
                         is about 7pt wider than the note - without the margin the corners get
                         clipped at the cell edge.
                         Centre on both axes: the fixed note size only wins over a stretching parent
                         when the alignment is not Fill, which is what keeps the note at its own size
                         while it is dragged (the drag overlay hands the card a much taller cell than
                         the column does).
                         Both sizes come from the card, which is as wide as its column unless the
                         notes are set to follow their content in the settings - then the note keeps
                         its usual width but is cut down to the height its ink needs, so it only
                         takes up the room that needs. -->
                    <Grid HeightRequest="{Binding CellHeight}"
                          WidthRequest="{Binding CellWidth}"
                          HorizontalOptions="Center"
                          VerticalOptions="Center">
                        <controls:StickyNoteBorder NoteColorIndex="{Binding Card.NoteColorIndex}"
                                                   NoteTilt="{Binding Card.NoteTilt}"
                                                   Padding="7"
                                                   HeightRequest="{Binding NoteHeight}"
                                                   WidthRequest="{Binding NoteWidth}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center">
                            <controls:StickyNoteBorder.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCardTapped" />
                            </controls:StickyNoteBorder.GestureRecognizers>
                            <Grid>
                                <controls:InkPreviewView HorizontalOptions="Fill"
                                                         VerticalOptions="Fill"
                                                         BackgroundColor="Transparent"
                                                         SourceRect="{Binding NoteSource}"
                                                         StrokesSource="{Binding Card.InkCanvas.Strokes}" />
                                <!-- The tags pinned to the note, in its lower right corner. -->
                                <Label Text="{Binding Card.TagsText}"
                                       FontSize="16"
                                       HorizontalOptions="End"
                                       VerticalOptions="End"
                                       InputTransparent="True" />
                            </Grid>
                        </controls:StickyNoteBorder>
                    </Grid>
                </DataTemplate>
            </kanban:SfKanban.CardTemplate>
        </kanban:SfKanban>
    </Grid>
</ContentPage>
