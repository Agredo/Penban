<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:markup="clr-namespace:Penban.Maui.Views.Markup"
             xmlns:controls="clr-namespace:Penban.Maui.Views.Controls"
             xmlns:kanban="clr-namespace:Syncfusion.Maui.Kanban;assembly=Syncfusion.Maui.Kanban"
             x:Class="Penban.Maui.Views.Pages.BoardPage"
             Title="{Binding Title}">
    <Grid RowDefinitions="*,Auto" Padding="12" RowSpacing="12">
        <kanban:SfKanban x:Name="BoardKanban"
                         Grid.Row="0"
                         AutoGenerateColumns="False"
                         ColumnMappingPath="Category">
            <kanban:SfKanban.CardTemplate>
                <DataTemplate>
                    <Border Padding="8"
                            StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}"
                            Background="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCardTapped" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="*">
                            <controls:InkPreviewView Grid.Row="0"
                                                     HeightRequest="120"
                                                     HorizontalOptions="Fill"
                                                     VerticalOptions="Fill"
                                                     BackgroundColor="Transparent"
                                                     StrokesSource="{Binding Card.InkCanvas.Strokes}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </kanban:SfKanban.CardTemplate>
        </kanban:SfKanban>
        <Button Grid.Row="1"
                Text="{markup:Translate AddColumn}"
                Command="{Binding AddColumnCommand}" />
    </Grid>
</ContentPage>
