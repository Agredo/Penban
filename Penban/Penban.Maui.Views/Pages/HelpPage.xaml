<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:markup="clr-namespace:Penban.Maui.Views.Markup"
             x:Class="Penban.Maui.Views.Pages.HelpPage"
             Title="{markup:Translate HelpTitle}"
             Shell.NavBarIsVisible="False"
             Style="{StaticResource AppPage}">
    <Grid RowDefinitions="Auto,*" Padding="20,12" RowSpacing="16">

        <!-- Own header instead of the Shell nav bar, like every other page in the app. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="6">
            <Button Grid.Column="0"
                    Text="&#xf15c;"
                    Style="{StaticResource GhostIconButton}"
                    Clicked="OnBackClicked"
                    SemanticProperties.Description="{markup:Translate HelpTitle}" />
            <Label Grid.Column="1"
                   Text="{markup:Translate HelpTitle}"
                   Style="{StaticResource TitleLabel}"
                   VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12">

                <Label Text="{markup:Translate HelpSubtitle}"
                       Style="{StaticResource CaptionLabel}" />

                <Border Style="{StaticResource CardBorder}" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{markup:Translate HelpDrawTitle}"
                               Style="{StaticResource SubtitleLabel}" />
                        <Label Text="{markup:Translate HelpDrawBody}"
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{markup:Translate HelpLassoTitle}"
                               Style="{StaticResource SubtitleLabel}" />
                        <Label Text="{markup:Translate HelpLassoBody}"
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{markup:Translate HelpShapeTitle}"
                               Style="{StaticResource SubtitleLabel}" />
                        <Label Text="{markup:Translate HelpShapeBody}"
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{markup:Translate HelpTextTitle}"
                               Style="{StaticResource SubtitleLabel}" />
                        <Label Text="{markup:Translate HelpTextBody}"
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{markup:Translate HelpSearchTitle}"
                               Style="{StaticResource SubtitleLabel}" />
                        <Label Text="{markup:Translate HelpSearchBody}"
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{markup:Translate HelpBoardsTitle}"
                               Style="{StaticResource SubtitleLabel}" />
                        <Label Text="{markup:Translate HelpBoardsBody}"
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{markup:Translate HelpBackupTitle}"
                               Style="{StaticResource SubtitleLabel}" />
                        <Label Text="{markup:Translate HelpBackupBody}"
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
