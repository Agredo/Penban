<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:markup="clr-namespace:Penban.Maui.Views.Markup"
             xmlns:ink="clr-namespace:Penban.Maui.Views.Ink"
             x:Class="Penban.Maui.Views.Pages.CardInkEditorPage"
             Title="Card"
             Style="{StaticResource AppPage}">
    <Grid RowDefinitions="*,Auto" Padding="16" RowSpacing="14">
        <Border Grid.Row="0"
                Padding="10"
                Style="{StaticResource CardBorder}">
            <ink:InkCanvasHostView x:Name="InkHost" />
        </Border>

        <Button Grid.Row="1"
                Text="{markup:Translate Done}"
                Style="{StaticResource PrimaryButton}"
                HorizontalOptions="Center"
                Clicked="OnDoneClicked" />
    </Grid>
</ContentPage>
