<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ink="clr-namespace:Penban.Maui.Views.Ink"
             x:Class="Penban.Maui.Views.Pages.CardInkEditorPage"
             Title="Card">
    <Grid RowDefinitions="*,Auto" Padding="12" RowSpacing="12">
        <Border Grid.Row="0"
                Padding="8"
                StrokeShape="RoundRectangle 8"
                Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}"
                Background="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}">
            <ink:InkCanvasHostView x:Name="InkHost" />
        </Border>

        <Button Grid.Row="1"
                Text="Fertig"
                Clicked="OnDoneClicked" />
    </Grid>
</ContentPage>
