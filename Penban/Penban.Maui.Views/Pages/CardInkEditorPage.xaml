<?xml version="1.0" encoding="utf-8" ?>
<!-- The editor is a page of the shell's own stack rather than a modal, so the shell's bar stands above
     it and carries the way back and the title - the board the card came from, handed in by the
     constructor. It is the only page in the app that keeps that bar: the others switch it off and draw
     their own header, because their headers carry buttons that would otherwise have to be squeezed
     into the bar's title view. This page has nothing to move up there - the row below is the tools -
     so it leaves the bar to the shell and takes its back button and its title with it.
     The bar's back button leaves the card the way "Fertig" does, and both keep the ink either way,
     see OnDisappearing in the code-behind. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:markup="clr-namespace:Penban.Maui.Views.Markup"
             xmlns:ink="clr-namespace:Penban.Maui.Views.Ink"
             xmlns:controls="clr-namespace:Penban.Maui.Views.Controls"
             x:Class="Penban.Maui.Views.Pages.CardInkEditorPage"
             Style="{StaticResource AppPage}">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <!-- Everything that is a button or a colour lives in the one row above the note, so the note
             keeps the whole height underneath it: the drawing tools, the two pens and the paper
             colours scroll, and the way into the ring plus the two buttons that leave the card are
             pinned to the right end of the row, where they are always one press away.
             The scrolling part is always drawn, whatever the tools setting says: the row is as high as
             the buttons pinned to its right end either way, so hiding the tools takes no height off the
             note, it only puts them out of reach.
             Drawing tools: one button for the two ways the pen draws, one for the eraser, and one each
             to undo and redo the last edit. Each button carries the glyph of the same tool that the
             radial menu draws on its ring, and the words that used to be on them are what a screen
             reader reads out. The font size is set here rather than left to the two styles so a button
             that changes between them does not change the size of its glyph with it.
             The pens come next, drawn as pens rather than as buttons, and they are what says which
             colour and which width the next stroke gets - see the slot styles in Theme.xaml. The two
             pens are built in the code-behind, one per stored slot, because the number of them and
             everything on them is a stored value rather than a decision this file can make. Behind
             them stands the button that wipes the note - one edit, so undo brings it back - and behind
             that the paper colours, each palette behind its own hairline. Horizontally scrollable,
             because the tools and the colours together are wider than any phone held upright. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <ScrollView x:Name="ToolBar" Grid.Column="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8">
                    <!-- The pen and the finger share one button: it carries the mode that is drawing
                         - a finger draws as well, or only the pencil does - and pressing it hands over
                         to the other one. The glyph of the two (pen U+E8D8, finger U+E6D8) and the
                         words it is read out with are put on in the code-behind, because that is what
                         tells the two modes apart. Eraser = U+E5E5, undo = U+F19A, redo = U+F16F,
                         clear = U+F201, radial menu = U+F07A5. -->
                    <Button x:Name="DrawModeButton"
                            FontSize="20"
                            Style="{StaticResource GhostIconButton}"
                            Clicked="OnDrawModeClicked" />
                    <Button x:Name="EraserButton"
                            Text="&#xe5e5;"
                            FontSize="20"
                            Style="{StaticResource GhostIconButton}"
                            Clicked="OnEraserClicked"
                            SemanticProperties.Description="{markup:Translate Eraser}" />
                    <Button x:Name="UndoButton"
                            Text="&#xf19a;"
                            FontSize="20"
                            Style="{StaticResource GhostIconButton}"
                            Clicked="OnUndoClicked"
                            SemanticProperties.Description="{markup:Translate Undo}" />
                    <!-- Undo and redo are also on two- and three-finger taps, so the buttons are the
                         visible half of the same feature. -->
                    <Button x:Name="RedoButton"
                            Text="&#xf16f;"
                            FontSize="20"
                            Style="{StaticResource GhostIconButton}"
                            Clicked="OnRedoClicked"
                            SemanticProperties.Description="{markup:Translate Redo}" />
                    <!-- A hairline, so the pens read as the other half of the same row rather than as
                         more tools. -->
                    <BoxView x:Name="PenSeparator"
                             WidthRequest="1"
                             HeightRequest="24"
                             VerticalOptions="Center"
                             Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                    <!-- The pens. Filled in from the stored slots in the code-behind; the one that is
                         drawing wears the frame that says so. -->
                    <HorizontalStackLayout x:Name="PenSlotRow" Spacing="2" VerticalOptions="Center" />
                    <!-- Wipes the note in one edit. It sits with the pens rather than with the paper
                         colours because that is what it acts on - the ink, not the note. -->
                    <Button x:Name="ClearButton"
                            Text="&#xf201;"
                            FontSize="20"
                            Style="{StaticResource GhostIconButton}"
                            Clicked="OnClearClicked"
                            SemanticProperties.Description="{markup:Translate ClearNote}" />
                    <!-- The paper colours sit behind a hairline of their own, so the two palettes are told
                         apart at a glance: the first one is the ink, this one is the note. -->
                    <BoxView x:Name="NoteColorSeparator"
                             WidthRequest="1"
                             HeightRequest="24"
                             VerticalOptions="Center"
                             Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                    <!-- Paper colours, filled in from the palette so a swatch is the note itself. -->
                    <HorizontalStackLayout x:Name="ColorPicker" Spacing="10" Padding="2" VerticalOptions="Center" />
                    <!-- Tags: emoji pinned to the note, filled in from CardTags.Palette in the
                         code-behind. Hidden for the board's own note, which cannot carry any. -->
                    <BoxView x:Name="TagSeparator"
                             WidthRequest="1"
                             HeightRequest="24"
                             VerticalOptions="Center"
                             Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                    <HorizontalStackLayout x:Name="TagPicker" Spacing="4" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </ScrollView>

            <!-- The way into the ring, the settings and the two ways out of the card. They stay outside
                 the scrolling row so they are always one press away: the ring is what a free finger taps
                 on the note, and the button is what is left when there is no free finger or no right
                 mouse button. Without the ring - the toolbar mode - the button that opens it is gone
                 with it.
                 The settings stand at the head of the row, apart from the two ways out: they are not
                 a way out of the card, and the drawing settings are what is tried out on this very
                 note. It is the same button as on the overview and on the board. -->
            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                <Button Text="&#xf588;"
                        Style="{StaticResource GhostIconButton}"
                        Clicked="OnSettingsClicked"
                        SemanticProperties.Description="{markup:Translate Settings}" />
                <Button x:Name="MenuButton"
                        Text="&#xf07a5;"
                        FontSize="20"
                        Style="{StaticResource GhostIconButton}"
                        Clicked="OnMenuClicked"
                        SemanticProperties.Description="{markup:Translate RadialMenu}" />
                <Button x:Name="DeleteButton"
                        Text="{markup:Translate Delete}"
                        Style="{StaticResource DangerGhostButton}"
                        Clicked="OnDeleteClicked" />
                <Button x:Name="DoneButton"
                        Text="{markup:Translate Done}"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="OnDoneClicked" />
            </HorizontalStackLayout>
        </Grid>

        <!-- The writing surface is the very note that sits on the board, in its own paper colour
             (set from the view model in the constructor). Strokes are stored dark-on-light.
             NoteArea is only a measuring cell: it reports the free space so the note can be kept
             square without the note ever feeding its own size back into the layout. -->
        <Grid Grid.Row="1" x:Name="NoteArea">
            <Border x:Name="NoteFrame"
                    Padding="10"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Style="{StaticResource CardBorder}">
                <controls:StickyNoteBorder x:Name="NoteSurface" Padding="0">
                    <ink:InkCanvasHostView x:Name="InkHost" BackgroundColor="Transparent" />
                </controls:StickyNoteBorder>
            </Border>

            <!-- The pen flyout: what the pen that is drawing is made of, opened by pressing that pen
                 a second time - the first press takes the other one up. It hangs downward from the top
                 of this cell - which is where the row above ends - so it covers the top of the note
                 rather than pushing it down, and it is placed sideways in the code-behind, under the
                 pen that opened it. It is the last child of the cell, so it lies over the note; the
                 ring is a child of the page and stays above both.
                 Every control in here writes into that same pen: there is one pen and one set of
                 controls for it, not a setting beside a pen, so the slot in the row and this flyout
                 can never disagree. The order runs from the least to the most effort - the colours
                 that were just used, the palette, a code, and then the two things a code cannot say:
                 which hue and how wide. The square and the bar are drawn here rather than bought in,
                 because a picker is a rectangle of colours and a mark on it. -->
            <Border x:Name="PenFlyout"
                    IsVisible="False"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    Padding="14,12"
                    WidthRequest="272"
                    Style="{StaticResource CardBorder}">
                <ScrollView VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="10">
                        <!-- Which pen this is. Set in the code-behind, because it is the pen's number
                             and that is not known here. -->
                        <Label x:Name="PenFlyoutTitle" Style="{StaticResource BodyLabel}" />

                        <Label Text="{markup:Translate PenRecentColors}" Style="{StaticResource CaptionLabel}" />
                        <HorizontalStackLayout x:Name="RecentColors" Spacing="8" />

                        <Label Text="{markup:Translate PenPalette}" Style="{StaticResource CaptionLabel}" />
                        <!-- Filled in from the same palette the ring draws, so a colour is in the same
                             place whichever of the two was used. -->
                        <FlexLayout x:Name="PenPalette" Wrap="Wrap" Direction="Row" />

                        <!-- A colour from anywhere: what the palette cannot hold. The swatch beside the
                             field is the colour the code says, so it can be checked before it is used.
                             A code that cannot be read is not applied - the pen keeps what it had - and
                             the field says so underneath instead. -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto">
                            <Border Grid.Row="0" Grid.Column="0" Padding="10,0" Style="{StaticResource InputSurface}">
                                <Entry x:Name="PenHexEntry"
                                       Placeholder="{markup:Translate PenHexPlaceholder}"
                                       TextChanged="OnPenHexChanged" />
                            </Border>
                            <Border x:Name="PenHexSwatch"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    WidthRequest="34"
                                    HeightRequest="34"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                            <Label x:Name="PenHexError"
                                   Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   IsVisible="False"
                                   Text="{markup:Translate PenHexInvalid}"
                                   Style="{StaticResource PenHexError}" />
                        </Grid>

                        <!-- The hue, then how strong and how bright it is. Both mark where the pen's
                             colour is now, and both write back into the pen while they are dragged. -->
                        <controls:HueStripView x:Name="HueStrip" HeightRequest="26" />
                        <controls:ColorAreaView x:Name="ColorArea" HeightRequest="112" />

                        <Label Text="{markup:Translate PenThicknessTitle}" Style="{StaticResource CaptionLabel}" />
                        <!-- The width, continuously: there are no steps to land between, so the slider
                             is the whole range and the number beside it says where in it the pen is.
                             The pen next to them is the same drawing the row shows, so the width that
                             is set can be read off it as it is dragged. -->
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <Slider x:Name="ThicknessSlider"
                                    Grid.Column="0"
                                    VerticalOptions="Center"
                                    ValueChanged="OnThicknessSliderChanged" />
                            <Label x:Name="ThicknessValue"
                                   Grid.Column="1"
                                   VerticalOptions="Center"
                                   Style="{StaticResource BodyLabel}" />
                            <controls:PenGlyphView x:Name="ThicknessPreview"
                                                   Grid.Column="2"
                                                   WidthRequest="26"
                                                   HeightRequest="48"
                                                   Style="{StaticResource PenGlyph}" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- The radial menu covers the whole page so a press beside it can be told from one on it:
             it is transparent and lets touches through until it is opened, and the ring is drawn
             around the point it was opened at. Last child, so it is above the note it was asked for
             from. -->
        <ink:RadialMenuView x:Name="RadialMenu"
                            Grid.RowSpan="2"
                            BackgroundColor="Transparent"
                            InputTransparent="True" />
    </Grid>
</ContentPage>
