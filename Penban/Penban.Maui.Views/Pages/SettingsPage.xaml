<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:markup="clr-namespace:Penban.Maui.Views.Markup"
             x:Class="Penban.Maui.Views.Pages.SettingsPage"
             Title="{markup:Translate Settings}"
             Shell.NavBarIsVisible="False"
             Style="{StaticResource AppPage}">
    <Grid RowDefinitions="Auto,*" Padding="20,12" RowSpacing="16">

        <!-- Own header instead of the Shell nav bar, like every other page in the app. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="6">
            <Button Grid.Column="0"
                    Text="&#xf15c;"
                    Style="{StaticResource GhostIconButton}"
                    Clicked="OnBackClicked"
                    SemanticProperties.Description="{markup:Translate Settings}" />
            <Label Grid.Column="1"
                   Text="{markup:Translate Settings}"
                   Style="{StaticResource TitleLabel}"
                   VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12">

                <Label Text="{markup:Translate SettingsDrawingSection}"
                       Style="{StaticResource CaptionLabel}" />

                <!-- Separators lead the row they separate, they do not trail it. Some rows are hidden
                     per platform, and a trailing separator would then be the last thing in the card on
                     whichever platform hides the row that followed it. -->
                <Border Style="{StaticResource CardBorder}" Padding="16,6">
                    <VerticalStackLayout Spacing="0">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                            <Label Grid.Column="0"
                                   Text="{markup:Translate AllowFingerDrawing}"
                                   Style="{StaticResource BodyLabel}"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding AllowFingerDrawing}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                        <!-- The row of tools above the note is drawn either way; what is picked
                             here is whether the radial menu is offered as well, or whether the row
                             is the only way in. Both carry the same tools and the same palettes. -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                            <Label Grid.Column="0"
                                   Text="{markup:Translate InkToolUi}"
                                   Style="{StaticResource BodyLabel}"
                                   VerticalOptions="Center" />
                            <Picker Grid.Column="1"
                                    WidthRequest="190"
                                    ItemsSource="{Binding InkToolUiNames}"
                                    SelectedIndex="{Binding SelectedInkToolUiIndex}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                            <Label Grid.Column="0"
                                   Text="{markup:Translate PressureSensitiveWidth}"
                                   Style="{StaticResource BodyLabel}"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding PressureSensitiveWidth}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                            <Label Grid.Column="0"
                                   Text="{markup:Translate ShapeRecognition}"
                                   Style="{StaticResource BodyLabel}"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding ShapeRecognitionEnabled}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <!-- Only iOS has a pencil that reports a double-tap (and a Pencil Pro a
                             squeeze), so the row is hidden elsewhere rather than offering a switch
                             that would do nothing. What it switches is whether the app honours what
                             iOS itself was told to do with those two gestures. -->
                        <VerticalStackLayout x:Name="PencilTapRow" Spacing="0">
                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                                <Label Grid.Column="0"
                                       Text="{markup:Translate PencilDoubleTapEnabled}"
                                       Style="{StaticResource BodyLabel}"
                                       VerticalOptions="Center" />
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding PencilDoubleTapEnabled}"
                                        VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- The eraser end of a pen is a Windows thing (Surface Pen); no other
                             platform reports which end is down, so the row is hidden there rather
                             than offering a switch that would do nothing. -->
                        <VerticalStackLayout x:Name="PenTailEraserRow" Spacing="0">
                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                                <Label Grid.Column="0"
                                       Text="{markup:Translate PenTailEraser}"
                                       Style="{StaticResource BodyLabel}"
                                       VerticalOptions="Center" />
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding PenTailEraserEnabled}"
                                        VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- The button on the pen is a Windows thing in the same way: only a Surface
                             Pen says that it is down, so the row is hidden elsewhere as well. -->
                        <VerticalStackLayout x:Name="PenButtonLassoRow" Spacing="0">
                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                                <Label Grid.Column="0"
                                       Text="{markup:Translate PenButtonLasso}"
                                       Style="{StaticResource BodyLabel}"
                                       VerticalOptions="Center" />
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding PenButtonLassoEnabled}"
                                        VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <Label Text="{markup:Translate SettingsGesturesSection}"
                       Style="{StaticResource CaptionLabel}"
                       Margin="0,6,0,0" />

                <!-- The two taps are the same shortcut as the undo and redo buttons in the editor,
                     so they can be turned off for anyone who rests a hand on the screen. -->
                <Border Style="{StaticResource CardBorder}" Padding="16,6">
                    <VerticalStackLayout Spacing="0">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                            <Label Grid.Column="0"
                                   Text="{markup:Translate TwoFingerTapUndo}"
                                   Style="{StaticResource BodyLabel}"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding TwoFingerTapUndoEnabled}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                            <Label Grid.Column="0"
                                   Text="{markup:Translate ThreeFingerTapRedo}"
                                   Style="{StaticResource BodyLabel}"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding ThreeFingerTapRedoEnabled}"
                                    VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <Label Text="{markup:Translate SettingsBoardSection}"
                       Style="{StaticResource CaptionLabel}"
                       Margin="0,6,0,0" />

                <Border Style="{StaticResource CardBorder}" Padding="16,6">
                    <VerticalStackLayout Spacing="0">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                            <Label Grid.Column="0"
                                   Text="{markup:Translate AutoSizeCards}"
                                   Style="{StaticResource BodyLabel}"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding AutoSizeCards}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                        <!-- Only the start is decided here: a note that already carries writing
                             opens in the mode it was left in, so this setting cannot cover up what
                             is on an older note. -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                            <Label Grid.Column="0"
                                   Text="{markup:Translate TextModeDefault}"
                                   Style="{StaticResource BodyLabel}"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding TextModeDefault}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                        <!-- A note that carries both ink and typed text would be unreadable in the
                             text mode with the ink still under it, which is why this is on by
                             default; whoever wants the ink as a background can turn it off. -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                            <Label Grid.Column="0"
                                   Text="{markup:Translate TextHideInkTitle}"
                                   Style="{StaticResource BodyLabel}"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding HideInkInTextMode}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                            <Label Grid.Column="0"
                                   Text="{markup:Translate TiltDetectionEnabled}"
                                   Style="{StaticResource BodyLabel}"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding TiltDetectionEnabled}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                        <!-- Both settings work with the pen's lean, and only the platform input
                             handler reads that while tilt detection is on: the switch above makes
                             the stroke wider the flatter the pen lies, this one turns that width
                             into the nib's own shape, which makes it depend on the direction the pen
                             is dragged in. Without the lean there is nothing for either to work
                             with, so this one is only reachable once that is on. -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                            <Label Grid.Column="0"
                                   Text="{markup:Translate TiltRenderingEffect}"
                                   Style="{StaticResource BodyLabel}"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding TiltRenderingEffect}"
                                    IsEnabled="{Binding TiltDetectionEnabled}"
                                    VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <Label Text="{markup:Translate SettingsRecognitionSection}"
                       Style="{StaticResource CaptionLabel}"
                       Margin="0,6,0,0" />

                <!-- The only setting here whose cost is measured in minutes, so it explains itself:
                     a switch that reads handwriting in the background is one whose effect on the
                     battery nobody would guess from its name. -->
                <Border Style="{StaticResource CardBorder}" Padding="16,6">
                    <VerticalStackLayout Spacing="0">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="{markup:Translate RecognitionEnabled}"
                                       Style="{StaticResource BodyLabel}" />
                                <Label Text="{markup:Translate RecognitionEnabledHelp}"
                                       Style="{StaticResource CaptionLabel}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding RecognitionEnabled}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <!-- Reading only happens on the way past a note, so the notes written before
                             the switch was turned on need a pass of their own. It shows how far it
                             has come because it takes minutes. -->
                        <BoxView HeightRequest="1"
                                 IsVisible="{Binding RecognitionEnabled}"
                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                        <VerticalStackLayout Spacing="8"
                                             Padding="0,10"
                                             IsVisible="{Binding RecognitionEnabled}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{markup:Translate RecognitionIndexAll}"
                                           Style="{StaticResource BodyLabel}" />
                                    <Label Text="{markup:Translate RecognitionIndexAllHelp}"
                                           Style="{StaticResource CaptionLabel}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="{markup:Translate RecognitionIndexAllAction}"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding IndexAllNotesCommand}"
                                        VerticalOptions="Center" />
                            </Grid>

                            <ProgressBar Progress="{Binding IndexProgress}"
                                         IsVisible="{Binding IsIndexingNotes}"
                                         ProgressColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                            <Label Text="{Binding IndexProgressLabel}"
                                   IsVisible="{Binding IsIndexingNotes}"
                                   Style="{StaticResource CaptionLabel}" />
                            <Label Text="{Binding IndexResultLabel}"
                                   IsVisible="{Binding HasIndexedNotes}"
                                   Style="{StaticResource CaptionLabel}" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <Label Text="{markup:Translate SettingsSupportSection}"
                       Style="{StaticResource CaptionLabel}"
                       Margin="0,6,0,0" />

                <!-- Each of these opens a page of its own, so every row is a plain navigation row. All
                     four are always visible, so the separators sit between them without needing to
                     know which one comes first. -->
                <Border Style="{StaticResource CardBorder}" Padding="16,6">
                    <VerticalStackLayout Spacing="0">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnHelpClicked" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0"
                                   Text="{markup:Translate HelpTitle}"
                                   Style="{StaticResource BodyLabel}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="&#xf2b1;"
                                   Style="{StaticResource IconLabel}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFeedbackClicked" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0"
                                   Text="{markup:Translate FeedbackTitle}"
                                   Style="{StaticResource BodyLabel}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="&#xf2b1;"
                                   Style="{StaticResource IconLabel}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPrivacyClicked" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0"
                                   Text="{markup:Translate PrivacyTitle}"
                                   Style="{StaticResource BodyLabel}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="&#xf2b1;"
                                   Style="{StaticResource IconLabel}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,10">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAboutClicked" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0"
                                   Text="{markup:Translate AboutTitle}"
                                   Style="{StaticResource BodyLabel}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="&#xf2b1;"
                                   Style="{StaticResource IconLabel}"
                                   VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- The version also stands on the About page; here it saves a support case the trip
                     there. Filled in from AppVersion in OnAppearing. -->
                <Label x:Name="VersionLabel"
                       Style="{StaticResource CaptionLabel}"
                       HorizontalTextAlignment="Center"
                       Margin="0,6,0,4" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
