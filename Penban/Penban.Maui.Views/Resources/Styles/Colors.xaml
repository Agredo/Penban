<?xml version="1.0" encoding="utf-8" ?>
<!-- Design tokens: light theme. Every key has a *Dark counterpart in Colors.Dark.xaml;
     consume them via {AppThemeBinding Light={StaticResource XLight}, Dark={StaticResource XDark}}
     or through the shared styles in Theme.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     x:Class="Penban.Maui.Views.Resources.Styles.Colors">

    <!-- Brand / accent (indigo) -->
    <Color x:Key="AccentLight">#4F46E5</Color>
    <Color x:Key="AccentPressedLight">#4338CA</Color>
    <Color x:Key="OnAccentLight">#FFFFFF</Color>

    <!-- Surfaces -->
    <Color x:Key="BackgroundLight">#F7F7F8</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceSecondaryLight">#F0F0F3</Color>

    <!-- Strokes -->
    <Color x:Key="BorderLight">#E4E4E8</Color>
    <Color x:Key="BorderStrongLight">#CFCFD6</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryLight">#17171A</Color>
    <Color x:Key="TextSecondaryLight">#6E6E78</Color>
    <Color x:Key="TextTertiaryLight">#A3A3AD</Color>

    <!-- Feedback -->
    <Color x:Key="DangerLight">#DC2626</Color>
    <Color x:Key="ScrimLight">#66000000</Color>

    <!-- Paper stays light in both themes: ink strokes are stored dark-on-light,
         so every ink surface (thumbnails, editor canvas) must remain paper-bright. -->
    <Color x:Key="PaperColor">#FCFCFD</Color>

</ResourceDictionary>
