<?xml version="1.0" encoding="utf-8" ?>
<!-- Shared component styles built on the color tokens (Colors.xaml / Colors.Dark.xaml).
     Pages should consume these styles instead of raw colors so the whole app stays on one
     design language. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:styles="clr-namespace:Penban.Maui.Views.Resources.Styles"
                    xmlns:controls="clr-namespace:Penban.Maui.Views.Controls"
                    x:Class="Penban.Maui.Views.Resources.Styles.Theme">

    <!-- Class-based dictionaries resolve their StaticResource lookups during InitializeComponent,
         before App.xaml has merged anything — so the color tokens must live in this dictionary's
         own merged scope to be visible. -->
    <ResourceDictionary.MergedDictionaries>
        <styles:Colors />
        <styles:ColorsDark />
    </ResourceDictionary.MergedDictionaries>

    <!-- Typography scale -->
    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeSubtitle">16</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="FontSizeLargeTitle">28</x:Double>

    <!-- Corner radius scale -->
    <x:Double x:Key="RadiusSmall">6</x:Double>
    <x:Double x:Key="RadiusMedium">10</x:Double>
    <x:Double x:Key="RadiusLarge">14</x:Double>

    <!-- ============ Pages ============ -->
    <Style x:Key="AppPage" TargetType="ContentPage">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
        <!-- Tapping off a text field puts the keyboard away again. MAUI gives no way to do this with a
             gesture of our own: the tap lands on whatever view is under the finger, so a recognizer on
             the page never sees the ones that land on a list. iOS and Android put their own recognizer
             on the window for this switch, which does see them. Windows ignores it. -->
        <Setter Property="HideSoftInputOnTapped" Value="True" />
    </Style>

    <!-- ============ Labels ============ -->
    <Style x:Key="LargeTitleLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLargeTitle}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="TitleLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="SubtitleLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="BodyLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="CaptionLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <!-- Icon glyphs rendered from the Fluent icon font. -->
    <Style x:Key="IconLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="FluentIcons" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- Caption of a form field, sitting above its input. -->
    <Style x:Key="FieldLabel" TargetType="Label" BasedOn="{StaticResource CaptionLabel}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>

    <!-- ============ Surfaces ============ -->
    <!-- Elevated card: surface fill, hairline border, soft shadow. -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background"
                Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#000000"
                        Opacity="{AppThemeBinding Light=0.07, Dark=0.35}"
                        Radius="8"
                        Offset="0,2" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filled surface behind an input control (Entry/Editor/Picker), inset from the card it sits in. -->
    <Style x:Key="InputSurface" TargetType="Border">
        <Setter Property="Background"
                Value="{AppThemeBinding Light={StaticResource SurfaceSecondaryLight}, Dark={StaticResource SurfaceSecondaryDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
    </Style>

    <!-- ============ Buttons ============ -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="18,11" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource AccentPressedLight}, Dark={StaticResource AccentPressedDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource AccentPressedLight}, Dark={StaticResource AccentPressedDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                            <Setter Property="TextColor"
                                    Value="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Quiet text button for secondary actions (cancel etc.). -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor"
                Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="Padding" Value="18,11" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource SurfaceSecondaryLight}, Dark={StaticResource SurfaceSecondaryDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource SurfaceSecondaryLight}, Dark={StaticResource SurfaceSecondaryDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Icon-only button that fades in importance (delete, close affordances). -->
    <Style x:Key="GhostIconButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
        <Setter Property="FontFamily" Value="FluentIcons" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="6" />
        <!-- 44x44 matches Apple's HIG minimum touch target so this is reliably tappable
             with a finger or Apple Pencil on iPad, not just a mouse pointer. -->
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource SurfaceSecondaryLight}, Dark={StaticResource SurfaceSecondaryDark}}" />
                            <Setter Property="TextColor"
                                    Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource SurfaceSecondaryLight}, Dark={StaticResource SurfaceSecondaryDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Round accent action (header "+"). -->
    <Style x:Key="AccentIconButton" TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
        <Setter Property="FontFamily" Value="FluentIcons" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <!-- 44x44 matches Apple's HIG minimum touch target so this is reliably tappable
             with a finger or Apple Pencil on iPad, not just a mouse pointer. -->
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource AccentPressedLight}, Dark={StaticResource AccentPressedDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource AccentPressedLight}, Dark={StaticResource AccentPressedDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Round accent action that floats over the content in the bottom right corner (add board, add
         column). 56 across with half of that as the corner radius, which is a circle rather than a
         rounded square; the shadow is what lifts it off the list or the board it lies on. -->
    <Style x:Key="FabButton" TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
        <Setter Property="FontFamily" Value="FluentIcons" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="56" />
        <Setter Property="MinimumWidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#000000"
                        Opacity="{AppThemeBinding Light=0.18, Dark=0.45}"
                        Radius="10"
                        Offset="0,3" />
            </Setter.Value>
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource AccentPressedLight}, Dark={StaticResource AccentPressedDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource AccentPressedLight}, Dark={StaticResource AccentPressedDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Destructive variant of the icon button. -->
    <Style x:Key="DangerGhostIconButton" TargetType="Button" BasedOn="{StaticResource GhostIconButton}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="TextColor"
                                    Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource SurfaceSecondaryLight}, Dark={StaticResource SurfaceSecondaryDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="TextColor"
                                    Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ============ Pens ============ -->

    <!-- One pen of the card editor's row. The frame is invisible until the pen is the one drawing, so
         the two pens stand side by side as plain drawings of pens rather than as two buttons; the
         padding is what keeps the drawing clear of the rounded corners the frame is drawn with. -->
    <Style x:Key="PenSlot" TargetType="Border">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="WidthRequest" Value="52" />
        <Setter Property="HeightRequest" Value="60" />
    </Style>

    <!-- The pen that is drawing: the frame around it is what says which of the two it is, so it is the
         only thing that has to change when the other one is taken up. -->
    <Style x:Key="PenSlotActive" TargetType="Border" BasedOn="{StaticResource PenSlot}">
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceSecondaryDark}}" />
    </Style>

    <!-- The pen itself. Its outline cannot be a fixed colour: the row is drawn on the page's own
         background, which is light in one theme and dark in the other, and a black outline would
         disappear into the second. -->
    <Style x:Key="PenGlyph" TargetType="controls:PenGlyphView">
        <Setter Property="OutlineColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <!-- A hex code that is not a colour. -->
    <Style x:Key="PenHexError" TargetType="Label" BasedOn="{StaticResource CaptionLabel}">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
    </Style>

</ResourceDictionary>
