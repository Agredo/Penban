<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ink="clr-namespace:Penban.Maui.Views.Ink"
             x:Class="Penban.Maui.Views.Controls.KanbanCardView"
             x:Name="CardViewRoot">
    <Border x:Name="CardBorder"
            Padding="8"
            Style="{StaticResource CardBorder}">
        <Grid RowDefinitions="Auto,*" RowSpacing="4">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Border x:Name="DragHandleHost"
                        Grid.Column="0"
                        Padding="8,4"
                        MinimumWidthRequest="36"
                        MinimumHeightRequest="32"
                        StrokeShape="RoundRectangle 6"
                        Background="{AppThemeBinding Light={StaticResource SurfaceSecondaryLight}, Dark={StaticResource SurfaceSecondaryDark}}">
                    <Border.GestureRecognizers>
                      <DragGestureRecognizer IsEnabled="{Binding Source={x:Reference CardViewRoot}, Path=EnableNativeDrag}"
                                             DragStarting="OnDragHandleDragStarting" />
                    </Border.GestureRecognizers>
                    <Label Text="&#xe9f9;"
                           Style="{StaticResource IconLabel}"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
                </Border>
                <Button Grid.Column="2"
                        Text="&#xf34d;"
                        Style="{StaticResource DangerGhostIconButton}"
                        HorizontalOptions="End"
                        Command="{Binding DeleteCommand}" />
            </Grid>
            <ink:InkCanvasHostView x:Name="InkHost" Grid.Row="1" HeightRequest="140" />
        </Grid>
    </Border>
</ContentView>
